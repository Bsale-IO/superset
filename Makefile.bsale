# Bsale fork — build and publish frontend assets to ECR.
#
# Separate from the upstream Apache Makefile to avoid conflicts on rebase.
# Use:  make -f Makefile.bsale <target>
#
# Targets:
#   ecr-login                    Login docker to ECR (one-time per session)
#   build-and-push-staging       Build + push :feat-{branch}-{sha}
#   build-and-push-prod          Build + push :6.0.0 + :6.0.0-{sha}
#   prune-staging                Delete older :feat-{branch}-{sha} tags of this branch
#   print-vars                   Show resolved variables

REGISTRY    ?= 239630721544.dkr.ecr.us-east-1.amazonaws.com
REPO        ?= superset-frontend-assets
AWS_REGION  ?= us-east-1
PLATFORM    ?= linux/arm64

GIT_SHA     := $(shell git rev-parse --short HEAD)
GIT_BRANCH  := $(shell git rev-parse --abbrev-ref HEAD | sed 's|.*/||')
TAG         ?= $(GIT_SHA)

IMAGE       := $(REGISTRY)/$(REPO)

# Path to the bsale-bi-staging Terraform tfvars file. Auto-written by
# build-and-push-staging so `terraform apply` picks up the new image tag
# without manually editing source. Override if the repos live elsewhere.
TFVARS_PATH ?= ../bsale-bi-staging/terraform/staging.auto.tfvars

# Tag staging runs right now, read before build-and-push-staging overwrites the
# tfvars. prune-staging never deletes it, so a staging rollback target survives.
PREV_STAGING_TAG ?= $(shell sed -n 's/^frontend_assets_tag = "\(.*\)"/\1/p' $(TFVARS_PATH) 2>/dev/null)

# DRY_RUN=1 make -f Makefile.bsale prune-staging  -> only print what would go.
DRY_RUN ?=

.PHONY: help ecr-login build-and-push-staging build-and-push-prod prune-staging print-vars

help:
	@echo "Bsale Makefile (use: make -f Makefile.bsale <target>)"
	@echo ""
	@echo "Targets:"
	@echo "  ecr-login                    Login docker to ECR ($(REGISTRY))"
	@echo "  build-and-push-staging       Build + push :feat-$(GIT_BRANCH)-$(GIT_SHA) and write $(TFVARS_PATH)"
	@echo "  build-and-push-prod          Build + push :6.0.0 + :6.0.0-$(GIT_SHA)"
	@echo "  prune-staging                Delete older :feat-$(GIT_BRANCH)-* tags (DRY_RUN=1 to preview)"
	@echo "  print-vars                   Show resolved variables"

print-vars:
	@echo "REGISTRY    = $(REGISTRY)"
	@echo "REPO        = $(REPO)"
	@echo "AWS_REGION  = $(AWS_REGION)"
	@echo "PLATFORM    = $(PLATFORM)"
	@echo "GIT_SHA     = $(GIT_SHA)"
	@echo "GIT_BRANCH  = $(GIT_BRANCH)"
	@echo "TAG         = $(TAG)"
	@echo "IMAGE       = $(IMAGE)"
	@echo "TFVARS_PATH = $(TFVARS_PATH)"
	@echo "PREV_STAGING_TAG = $(PREV_STAGING_TAG)"

ecr-login:
	@aws ecr get-login-password --region $(AWS_REGION) | \
	  docker login --username AWS --password-stdin $(REGISTRY)

build-and-push-staging: ecr-login
	docker buildx build --platform $(PLATFORM) --push \
	  -t $(IMAGE):feat-$(GIT_BRANCH)-$(GIT_SHA) \
	  -f Dockerfile.assets .
	@mkdir -p $(dir $(TFVARS_PATH))
	@printf 'frontend_assets_tag = "feat-%s-%s"\n' "$(GIT_BRANCH)" "$(GIT_SHA)" > $(TFVARS_PATH)
	@echo ""
	@echo "Pushed: $(IMAGE):feat-$(GIT_BRANCH)-$(GIT_SHA)"
	@echo "Wrote:  $(TFVARS_PATH)"
	@echo ""
	@echo "Next:   cd $(dir $(TFVARS_PATH)) && terraform apply"
	@$(MAKE) --no-print-directory -f $(firstword $(MAKEFILE_LIST)) prune-staging \
	  PREV_STAGING_TAG="$(PREV_STAGING_TAG)" \
	  || echo "WARNING: prune-staging failed; older feat-$(GIT_BRANCH)-* tags were kept."

# One image per patch: the ECR lifecycle policy keeps only the 10 newest tagged
# images of ANY tag, so every staging iteration would push a 6.0.0-* release out.
# Deletes this branch's older iterations only: exact `feat-<branch>-<hex sha>`
# match (a branch named `treemap` never touches `feat-treemap-remove-...`), and
# never the tag just pushed nor the one staging currently runs. Release tags
# (6.0.0*) are never matched.
prune-staging:
	@current="feat-$(GIT_BRANCH)-$(GIT_SHA)"; \
	tags=$$(aws ecr list-images --region $(AWS_REGION) --repository-name $(REPO) \
	  --filter tagStatus=TAGGED --query 'imageIds[].imageTag' --output text | tr '\t' '\n' \
	  | grep -E '^feat-$(GIT_BRANCH)-[0-9a-f]+$$' \
	  | grep -vxF "$$current" | grep -vxF "$(PREV_STAGING_TAG)"); \
	if [ -z "$$tags" ]; then echo "prune-staging: nothing to delete for feat-$(GIT_BRANCH)-*"; exit 0; fi; \
	for t in $$tags; do \
	  if [ -n "$(DRY_RUN)" ]; then echo "prune-staging: would delete $$t"; \
	  else aws ecr batch-delete-image --region $(AWS_REGION) --repository-name $(REPO) \
	    --image-ids imageTag=$$t --query 'failures' --output text >/dev/null \
	    && echo "prune-staging: deleted $$t"; fi; \
	done

build-and-push-prod: ecr-login
	docker buildx build --platform $(PLATFORM) --push \
	  -t $(IMAGE):6.0.0 \
	  -t $(IMAGE):6.0.0-$(GIT_SHA) \
	  -f Dockerfile.assets .
